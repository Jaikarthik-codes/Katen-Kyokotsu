# Copy to .env for local development. Never commit .env.
DATABASE_URL=postgresql+psycopg://portfolio:portfolio@localhost:5432/portfolio
# JSON list of browser origins allowed to call the API.
CORS_ORIGINS=["http://localhost:5173"]
# Long random string; used to hash visitor IPs for the contact rate limit.
IP_HASH_SALT=change-me-to-a-long-random-string
# Set to true only behind a proxy that sets X-Forwarded-For (e.g. Render).
TRUST_PROXY_HEADERS=false
CONTACT_LIMIT_PER_HOUR=5
